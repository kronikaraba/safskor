# Sunucu portu
PORT=3000

# Veri sağlayıcı: auto | demo | api-football
#  auto: API_FOOTBALL_KEY varsa API-Football kullanılır, yoksa ya da API hata verirse demo verisine düşülür.
DATA_PROVIDER=auto

# API-Football (https://www.api-football.com) anahtarı. Yalnızca sunucuda tutulur, istemciye asla gönderilmez.
API_FOOTBALL_KEY=
# RapidAPI üzerinden kullanıyorsanız: https://api-football-v1.p.rapidapi.com/v3
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Takip edilecek lig kimlikleri (virgülle). Boş bırakılırsa bugünün tüm maçları. 203 = Süper Lig
API_FOOTBALL_LEAGUES=203,39,140,2
# Yoklama aralıkları (ms). Varsayılanlar ücretsiz plana (günde 100 istek) göre:
#  canlı/yaklaşan maç varken liste 20 dk, hiç maç yokken 2 saat; izlenen canlı maç detayı 10 dk.
LIST_POLL_MS=1200000
LIST_IDLE_POLL_MS=7200000
DETAIL_POLL_MS=600000
# Günlük istek hakkı ve her zaman boşta tutulacak yedek. Kota dolunca son gerçek veri gösterilir.
API_DAILY_LIMIT=100
API_RESERVE=5

# Demo modunda bir oyun dakikası kaç ms sürsün
DEMO_TICK_MS=4000

# Taraftar verileri (sohbet, puanlar, anketler) için SQLite dosyası
DB_PATH=./data/safskor.db
