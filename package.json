{
  "name": "safskor",
  "version": "0.1.0",
  "private": true,
  "description": "Canlı futbol maçları için etkileşimli taraftar platformu (MVP)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p .",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
